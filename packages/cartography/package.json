{
  "name": "@openstyle/cartography",
  "version": "0.7.0",
  "description": "Engine-neutral cartography contracts and utilities for safe style edits, line casing, render evidence, review, repair, and diff.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --tsconfig tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@openstyle/schema": "workspace:*",
    "zod": "^3.24.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gaopengbin/openstyle.git",
    "directory": "packages/cartography"
  },
  "keywords": [
    "cartography",
    "agent",
    "render",
    "review",
    "repair",
    "openstyle"
  ]
}
